    elementType: text
    bounds: [64, 262, 620, 26]
    content:
      style: "$body"
      fontSize: 13.5
      color: "$cream"
      wrap: false
      text: |
        <p>museus mapeados no Brasil — plataforma <a href="https://agenciagov.ebc.com.br/noticias/202401/ibram-celebra-15-anos-neste-sabado-20-e-lanca-a-plataforma-nova-museus-br">Museus BR / Ibram, 2024</a></p>
