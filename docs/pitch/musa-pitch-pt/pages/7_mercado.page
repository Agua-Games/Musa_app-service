      style: "$kicker"
      color: "$gold"
      text: 06 — MERCADO
  - elementId: bignum
    elementType: text
    bounds: [64, 110, 500, 140]
    content:
      fontFamily: Cormorant Garamond
      fontSize: 120
      color: "$gold"
