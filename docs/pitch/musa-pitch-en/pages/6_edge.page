    elementType: text
    bounds: [100, 170, 440, 20]
    content: {fontFamily: Inter, fontSize: 13.5, bold: true, color: "$ink", wrap: false, text: The collection belongs to the museum}
  - elementId: item1-desc
    elementType: text
    bounds: [100, 194, 440, 38]
