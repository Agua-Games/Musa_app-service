pageType: content
background: {type: solid, color: "$paper"}
elements:
  - elementId: kicker
    elementType: text
    bounds: [64, 48, 460, 18]
    content:
      style: "$kicker"
      color: "$bronze"
      text: 05 — WHY MUSA
  - elementId: title
    elementType: text
    bounds: [64, 72, 520, 88]
    content:
      fontFamily: Cormorant Garamond
      fontSize: 32
      color: "$ink"
      lineHeight: 1.15
      text: |
        <p>Defensible by design —</p>
        <p>not by secrecy.</p>
