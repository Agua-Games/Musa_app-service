    elementType: text
    bounds: [64, 48, 460, 18]
    content:
      style: "$kicker"
      color: "$gold"
      text: 04 — BUSINESS MODEL
  - elementId: title
    elementType: text
    bounds: [64, 80, 620, 52]
    content:
      fontFamily: Cormorant Garamond
      fontSize: 36
      color: "$paper"
      wrap: false
      text: Monthly subscription, per museum.
  - elementId: pricing
    elementType: table
    bounds: [64, 146, 832, 236]
    columnWidths: [0.2, 0.266, 0.267, 0.267]
    rowHeights: [0.22, 0.2, 0.38, 0.2]
    style: "$pricing"
    rows:
      - - text: ""
        - text: BRONZE
        - text: SILVER
        - text: GOLD
      - - text: monthly
        - text: R$ 597
          fontFamily: Cormorant Garamond
          fontSize: 21
          color: "$gold"
        - text: R$ 1,197
          fontFamily: Cormorant Garamond
          fontSize: 21
          color: "$gold"
        - text: R$ 3,197
          fontFamily: Cormorant Garamond
          fontSize: 21
          color: "$gold"
      - - text: includes
        - text: complete digital museum — website, searchable catalog and curator panel
        - text: everything in Bronze, plus interactive 3D and the AI assistant
        - text: everything in Silver, plus the whole museum mirrored online — digital twin and kiosks
      - - text: fit
        - text: first digital step
        - text: interactive experience
        - text: digital flagship
